# Database Configuration
POSTGRES_DB=gotlr_db
POSTGRES_USER=gotlr_user
POSTGRES_PASSWORD=gotlr_password
POSTGRES_HOST=db
POSTGRES_PORT=5472

# Django Backend Configuration
DJANGO_SECRET_KEY=django-insecure-some-very-secret-and-long-key-for-saas
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# FastAPI Backend Configuration
FASTAPI_SECRET_KEY=django-insecure-some-very-secret-and-long-key-for-saas
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI & LLM Service Configuration
# Get your Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenRouter API configurations
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_PROVIDER=gemini  # Options: gemini, openrouter

# Embedding Model settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage Directory for uploaded files and FAISS indices
STORAGE_DIR=/app/data
